# Copie este arquivo para .env e preencha. O .env nao vai para o git.
# O "flask run" le o .env sozinho (python-dotenv).

# Mercado Livre: App ID e Secret Key da aplicacao criada em
# https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Opcional em desenvolvimento
# SECRET_KEY=troque-esta-chave

# Mostra erros detalhados e recarrega o servidor ao salvar (so em desenvolvimento)
# FLASK_DEBUG=1

# Nivel do log: DEBUG, INFO, WARNING ou ERROR (o log fica em instance/logs/adoptme.log)
# LOG_LEVEL=INFO

# Banco de dados (padrao: SQLite em instance/adoptme.db)
# DATABASE_URL=sqlite:///adoptme.db
